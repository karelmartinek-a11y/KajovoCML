[Unit]
Description=KCML internal generation orchestrator
After=network-online.target postgresql.service kcml-egress-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=kcml
Group=kcml
WorkingDirectory=/opt/kcml/current
EnvironmentFile=/etc/kcml/worker.env
Environment=KCML_PROCESS_ROLE=worker
Environment=DATABASE_URL_FILE=%d/database_url
Environment=CONFIG_VAULT_MASTER_KEY_BASE64_FILE=%d/config_vault_master_key
Environment=ACCESS_TOKEN_HMAC_KEY_BASE64_FILE=%d/access_token_hmac
Environment=EGRESS_CAPABILITY_HMAC_KEY_BASE64_FILE=%d/egress_capability_hmac
LoadCredential=database_url:/etc/kcml/credentials/worker/database_url
LoadCredential=config_vault_master_key:/etc/kcml/credentials/config_vault_master_key
LoadCredential=access_token_hmac:/etc/kcml/credentials/worker/access_token_hmac
LoadCredential=egress_capability_hmac:/etc/kcml/credentials/worker/egress_capability_hmac
ExecStart=/usr/bin/node apps/server/dist/cli/generation-worker.js
Restart=on-failure
RestartSec=5
# The worker invokes the narrowly allow-listed kcml-generated-runtime-helper.
# Keep the helper boundary explicit in sudoers; these two hardening flags would
# otherwise make the approved setuid transition fail with EPERM.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=false
LockPersonality=true
ReadWritePaths=/var/lib/kcml/generation /var/lib/kcml/generated-components /var/lib/kcml/runtime

[Install]
WantedBy=multi-user.target
