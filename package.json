{
  "name": "kajovocml",
  "version": "2026.7.22-compliance.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @kcml/admin-ui build && pnpm --filter @kcml/server dev",
    "lint": "eslint .",
    "postinstall": "node scripts/clean-appledouble.mjs",
    "pretest": "node scripts/check-capability-parity.mjs && node scripts/clean-appledouble.mjs && node scripts/check-internal-generation-contract.mjs && node scripts/test-generated-handler-capabilities.mjs && node scripts/test-generated-component-runtime.mjs && node scripts/test-generation-browser.mjs && node scripts/test-generation-browser-automation.mjs && node scripts/test-generation-automation-recovery.mjs && node scripts/test-generation-cancellation.mjs && node scripts/test-generation-technical-failure-cleanup.mjs && node scripts/test-generation-integrating-secret-grant.mjs && node scripts/test-repair-enqueue-control.mjs && pnpm --filter @kcml/server exec tsx ../../scripts/test-generation-repair-authority.mjs && pnpm --filter @kcml/server exec tsx ../../scripts/test-generation-execution-authority.mjs && node scripts/test-generation-integration-phase.mjs && node scripts/test-generalized-external-egress.mjs && node scripts/test-generation-secret-autonomy.mjs && bash scripts/test-acme-deploy-hook.sh",
    "test": "vitest run --exclude '**/._*' --exclude 'components/**'",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @kcml/server db:migrate",
    "admin:sync-password": "pnpm --filter @kcml/server admin:sync-password",
    "wedos-wapi": "pnpm --filter @kcml/server wedos-wapi",
    "dashboard:parity:check": "node scripts/check-capability-parity.mjs",
    "generation:contract:check": "node scripts/check-internal-generation-contract.mjs",
    "generation:runtime:check": "node scripts/test-generated-component-runtime.mjs",
    "generation:browser:check": "node scripts/test-generation-browser.mjs",
    "generation:browser-automation:check": "node scripts/test-generation-browser-automation.mjs",
    "generation:automation:check": "node scripts/test-generation-browser-automation.mjs && pnpm exec vitest run apps/server/src/domain/browser-automation.test.ts",
    "generation:automation-sandbox-boundary:check": "node scripts/test-generated-handler-capabilities.mjs",
    "generation:automation-runtime-no-ai:check": "node scripts/test-generation-automation-runtime-no-ai.mjs",
    "generation:automation-recovery:check": "node scripts/test-generation-automation-recovery.mjs",
    "generation:live:check": "node scripts/test-generated-platform-live.mjs",
    "generation:capability:check": "node scripts/test-generated-handler-capabilities.mjs",
    "generation:cancellation:check": "node scripts/test-generation-cancellation.mjs",
    "generation:repair-enqueue:check": "node scripts/test-repair-enqueue-control.mjs",
    "generation:repair-authority:check": "pnpm --filter @kcml/server exec tsx ../../scripts/test-generation-repair-authority.mjs",
    "generation:execution-authority:check": "pnpm --filter @kcml/server exec tsx ../../scripts/test-generation-execution-authority.mjs",
    "generation:integration-phase:check": "node scripts/test-generation-integration-phase.mjs",
    "generation:egress:check": "node scripts/test-generalized-external-egress.mjs",
    "generation:secret-autonomy:check": "node scripts/test-generation-secret-autonomy.mjs",
    "generation:browser-cross-origin:check": "node scripts/test-generation-browser-cross-origin.mjs",
    "generation:failure-cleanup:check": "node scripts/test-generation-technical-failure-cleanup.mjs",
    "generation:integrating-secret-grant:check": "node scripts/test-generation-integrating-secret-grant.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "argon2": "^0.41.1"
  },
  "packageManager": "pnpm@11.7.0"
}
